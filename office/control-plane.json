{
  "name": "velvetos-office-control-plane",
  "title": "Office Control Plane — unify existing sources of truth",
  "updatedAt": "2026-09-10",
  "rule": "Unify and harden. Do not duplicate approval queue, calendar, media catalog, job ledger, print.done, office loop, or handoff concepts. If two files claim authority over the same domain, the sensor must fail.",
  "cli": "python3 scripts/vf_control_plane.py",
  "sensor": "scripts/check-office-control-plane.py",
  "workflow": ".github/workflows/office-control-plane.yml",
  "dontBotherChristian": {
    "green": "execute autonomously (classify, archive, draft internal, maintain handoff, routine quality fixes)",
    "yellow": "execute + report in brief (prepare content, organize media, calendar plan, watchdog repairs)",
    "orange": "prepare only, do not execute (new external message, unverified public claim, policy change, missing gate)",
    "red": "Christian approval required (purchase, payment, price change, destructive action, owner-only publish, hard blocker, irreversible deletion, uncovered business commitment)"
  },
  "sourcesOfTruth": {
    "policy": "constitution/CONSTITUTION.md + constitution/ORCHESTRA.md",
    "risk_policy": "office/control/POLICY.md",
    "jobs": "Google Sheet VF HQ · jobs (office/ledger/bindings.json) — local adapter cache office/ledger/live/jobs.csv via vf_office.py jobs pull",
    "jobs_bindings": "office/ledger/bindings.json",
    "jobs_cache": "office/ledger/live/jobs.csv",
    "media": "packages/vfmedia/catalog.json + docs/MEDIA-VAULT.md",
    "content_calendar": "packages/vfgrowth/CALENDAR.md",
    "content_approval": "packages/vfgrowth/data/approval-queue.json",
    "production_completion": "packages/vfprod/hq/cards/*.md via print.done",
    "office_loop": "packages/vfops/LOOP.json",
    "manager_handoff": "office/control/HANDOFF.json",
    "decisions": "office/control/decisions.jsonl",
    "dead_letter": "office/control/dead-letter.json",
    "followups": "office/control/followups.json",
    "public_cta": "constitution/PUBLIC_CTA.md",
    "publication_states": "packages/vfigos/PUBLICATION-STATES.json",
    "instagram_capabilities": "packages/vfigos/CAPABILITIES.json",
    "profile_desired": "packages/vfigos/PROFILE-DESIRED.json",
    "feed_audit": "packages/vfgrowth/data/feed-audit.json",
    "insights": "packages/vfinsights/data/ (MCP-verified via vf_insights_ingest.py)"
  },
  "controlDir": "office/control",
  "contentSprintPriority": [
    "ready_for_finished_content",
    "print.done_with_usable_media",
    "approved_waiting_for_slot",
    "new_media_from_intake",
    "general_new_content_ideas"
  ],
  "locks": [
    "no-duplicate-sources-of-truth",
    "no-duplicate-dead-letter",
    "no-duplicate-followups",
    "no-invented-prices",
    "no-invented-insights",
    "no-auto-dm",
    "no-meta-business-suite",
    "no-nationwide-shipping",
    "scheduling-is-not-publication",
    "live-requires-verification",
    "public-cta-instagram-message",
    "ig-needsauth-not-fake-ready",
    "upload-is-not-approval",
    "approved-folder-is-not-approval-proof",
    "no-owner-spam-from-low-level-gaps",
    "no-silent-dead-letter-loss",
    "autonomy-reconcile-before-retry",
    "autonomy-idempotency-required",
    "autonomy-no-second-runtime"
  ],
  "chatgptTaskReduction": {
    "keep": [
      "Velvet Morning Brief",
      "Velvet Research Seat — 06:15 live web research body; non-mechanical intelligence task",
      "optional Velvet Publish Watch / hard-blocker alert"
    ],
    "moveInsideVelvetOS": [
      "Media Intake",
      "Content Sprint",
      "Insights/Office Review",
      "Memory Hygiene",
      "Opportunity Radar",
      "WIP→Finished watcher",
      "Dead-letter monitoring",
      "routine watchdog",
      "source-of-truth validation",
      "Studio Pulse",
      "Universal Intake",
      "Invisible Work Detector",
      "Failure Museum",
      "Velvet Lab",
      "Living Studio Skills Registry"
    ],
    "note": "Keep only owner-facing/intelligence tasks in ChatGPT. Mechanical monitoring stays inside VelvetOS. Do not delete an existing task until its replacement path is proven."
  },
  "livingStudio": {
    "layer": "packages/velvetos/living-studio",
    "cli": "python3 scripts/vf_living_studio.py",
    "sensor": "scripts/check-living-studio.py",
    "registry": "packages/velvetos/living-studio/REGISTRY.json",
    "rule": "projection/router layer only — never a competing SoT",
    "commands": [
      "world-model",
      "pulse",
      "signal-room",
      "intake",
      "invisible-work",
      "failure-museum",
      "lab",
      "opportunity",
      "commercial-qa",
      "content-universe",
      "work-to-story",
      "commission",
      "selftest"
    ]
  },
  "autonomyComposition": {
    "config": "packages/velvetos/living-studio/AUTONOMY.json",
    "cli": "python3 scripts/vf_autonomy.py",
    "sensor": "scripts/check-vf-autonomy.py",
    "rule": "Compose routing, context, waiting, approvals, reliability, prioritization and quiet-hours policy over existing canonical SoTs. No second runtime or queue.",
    "commands": [
      "status",
      "next-action",
      "blockers",
      "approvals",
      "context",
      "quiet-plan",
      "snapshot",
      "execute",
      "selftest"
    ]
  },
  "projections": {
    "world_model": "packages/velvetos/living-studio/data/world-model-latest.json",
    "studio_pulse": "packages/velvetos/living-studio/data/pulse-latest.json",
    "signal_room": "packages/velvetos/living-studio/data/signal-room.jsonl",
    "autonomy_snapshot": "packages/velvetos/living-studio/data/autonomy-latest.json"
  }
}
