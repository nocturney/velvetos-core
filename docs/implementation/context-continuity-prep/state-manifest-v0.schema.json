{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velvetos-draft-context-continuity-manifest-v0",
  "title": "VelvetOS derived continuation manifest v0",
  "description": "Non-authoritative, rebuildable projection for context compaction/resume. Not a second checkpoint or handoff store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "authority",
    "work_id",
    "as_of",
    "sources",
    "execution",
    "resume",
    "verification"
  ],
  "properties": {
    "schema": {
      "const": "velvetos.draft.context-continuity-manifest.v0"
    },
    "status": {
      "const": "NON_NORMATIVE_REFORM_PREPARATION"
    },
    "authority": {
      "const": false
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 8
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Persistent/canonical/evidence/history references only. Ephemeral recent observations belong under execution.latest_observation or recent_tail, never as a fifth Stage 7A role.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "role",
          "resolved"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "CANONICAL_STATE",
              "EVIDENCE_RECEIPT",
              "AUTHORIZATION_DECISION",
              "AUDIT_HISTORY"
            ]
          },
          "resolved": {
            "type": "boolean"
          },
          "digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "completed_steps",
        "unresolved",
        "constraints"
      ],
      "properties": {
        "goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "planned_steps_remaining": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "component_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_state": {
          "type": "object",
          "additionalProperties": true
        },
        "latest_observation": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ephemeral O_t summary. It does not create a fifth Stage 7A semantic role."
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_step",
        "safe_to_resume"
      ],
      "properties": {
        "next_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "safe_to_resume": {
          "type": "boolean"
        },
        "gate": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "waiting_for": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "waiting_for"
          ]
        },
        "exact_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stable_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authorization_refs": {
      "type": "array",
      "description": "References only. Presence never authorizes an action by itself.",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recent_tail": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bounded transient working context. Not a canonical-state category or durable-memory promotion surface.",
      "properties": {
        "retained_turn_count": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_cache_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_compaction",
        "post_compaction",
        "authority_neutral"
      ],
      "properties": {
        "pre_compaction": {
          "enum": [
            "PASS",
            "FAIL",
            "UNPROVEN"
          ]
        },
        "post_compaction": {
          "enum": [
            "PASS",
            "FAIL",
            "UNPROVEN"
          ]
        },
        "authority_neutral": {
          "enum": [
            "PASS",
            "FAIL",
            "UNPROVEN"
          ]
        },
        "missing_preserved_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
