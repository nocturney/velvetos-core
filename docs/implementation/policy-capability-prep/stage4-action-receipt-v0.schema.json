{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velvetos.draft.stage4.action-receipt.v0",
  "title": "DRAFT ONLY — VelvetOS Stage 4 exact-action receipt",
  "description": "Non-normative proposal prepared during Stage 3 dormancy. It authorizes nothing and is not loaded by runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "non_normative",
    "action_receipt_id",
    "policy_id",
    "effect_class",
    "action",
    "exact_binding",
    "policy_decision",
    "owner_gate",
    "override",
    "evidence",
    "rollback"
  ],
  "properties": {
    "schema_version": {
      "const": "draft.stage4.action-receipt.v0"
    },
    "non_normative": {
      "const": true
    },
    "action_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "description": "Must resolve through the live canonical policy registry if this draft is ever implemented."
    },
    "effect_class": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "scope"
      ],
      "properties": {
        "action_type": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "subject_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "exact_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "payload_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "text_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uniqueItems": true
        }
      }
    },
    "policy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_ref",
        "outcome",
        "decided_at"
      ],
      "properties": {
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "owner_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "decision",
        "blocker_ids"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED",
            "NOT_REVIEWED",
            "NOT_REQUIRED"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "blocker_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reason",
        "scope",
        "expires_at"
      ],
      "properties": {
        "mode": {
          "enum": [
            "never",
            "exact_action_owner",
            "tighten_only"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "ref"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "instruction_ref"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "instruction_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "owner_gate": {
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "owner_gate": {
            "required": [
              "reviewer",
              "reviewed_at"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "override": {
            "properties": {
              "mode": {
                "const": "exact_action_owner"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "override": {
            "required": [
              "reason",
              "scope",
              "expires_at"
            ]
          }
        }
      }
    }
  ]
}
