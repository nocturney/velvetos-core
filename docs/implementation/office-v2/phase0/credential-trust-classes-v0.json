{
  "schema": "velvetos.office-v2.credential-trust-classes.v0",
  "status": "PHASE0",
  "secrets_in_git_allowed": false,
  "lab_receives_production_credentials_by_default": false,
  "credential_classes": [
    {
      "id": "LAB_ONLY_SECRET",
      "production_access": false,
      "description": "Credential usable only inside the isolated Office v2 LAB."
    },
    {
      "id": "PRODUCTION_READ",
      "production_access": true,
      "write_allowed": false,
      "description": "Read-only access to a specifically named production capability."
    },
    {
      "id": "PRODUCTION_SCOPED_WRITE",
      "production_access": true,
      "write_allowed": true,
      "description": "Bounded write access to one named provider/domain effect under canonical policy authority."
    },
    {
      "id": "OWNER_HIGH_IMPACT",
      "production_access": true,
      "write_allowed": true,
      "description": "High-impact production effect that remains subject to owner-level approval."
    },
    {
      "id": "HUMAN_ONLY",
      "production_access": true,
      "write_allowed": "human_only",
      "description": "Action intentionally unavailable to autonomous/runtime agents."
    }
  ],
  "binding_rules": [
    "Versioned definitions store class/reference metadata only.",
    "LAB receives no production credential by default.",
    "Re-binding follows the owning provider or protected runtime boundary.",
    "Node trust never implies external-effect authority."
  ],
  "node_trust_classes": [
    {
      "id": "TRUSTED_OWNER_NODE",
      "meaning": "owner-controlled workstation; still policy-gated"
    },
    {
      "id": "TRUSTED_SERVICE_RUNTIME",
      "meaning": "bounded production runtime with explicit capabilities"
    },
    {
      "id": "BOUNDED_EXTERNAL_PROVIDER",
      "meaning": "external API/connector; exact capability/effect scope only"
    },
    {
      "id": "UNVERIFIED_NODE",
      "meaning": "no mutation or authoritative runtime claim"
    }
  ],
  "production_bindings": [
    {
      "id": "phase3b-instagram-publisher-snapshot-read",
      "status": "READY_AWAITING_EXPLICIT_RUNTIME_AUTHORITY_TRANSFER",
      "scope_id": "instagram-publisher-snapshot-read",
      "production_domain": "instagram_read",
      "credential_class": "PRODUCTION_READ",
      "provider": "Cloudflare Worker velvetos-instagram-publisher",
      "provider_credential": "SNAPSHOT_TOKEN",
      "provider_native_rotation_and_revocation_required": true,
      "identity_provider": "ZITADEL",
      "principal": "svc:officev2-p3b-prod-publisher-snapshot",
      "authorization_engine": "OPA",
      "credential_broker": "OpenBao",
      "broker_path": "officev2-prod/data/instagram-publisher-snapshot",
      "broker_role": "officev2-prod-publisher-snapshot",
      "allowed_requests": [
        "GET /v1/runtime",
        "GET /v1/meta-health",
        "GET /v1/jobs",
        "GET /v1/jobs/{id}"
      ],
      "write_allowed": false,
      "control_token_forbidden": true,
      "meta_access_token_forbidden": true,
      "raw_secret_in_git_forbidden": true,
      "fallback_seek_allow_forbidden": true,
      "production_writer_change": false
    }
  ]
}
