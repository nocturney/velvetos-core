      ]
    },
    {
      "step_id": "checkpoint",
      "capability": "checkpoint",
      "side_effect_class": "REVERSIBLE_WRITE",
      "expected_evidence": [
        "checkpoint_receipt"
      ]
    },
    {
      "step_id": "crash",
      "capability": "failure.inject_or_observe",
      "side_effect_class": "NONE",
      "expected_evidence": [
        "failure_receipt"
      ]
    },
    {
      "step_id": "resume",
      "capability": "resume",
      "side_effect_class": "REVERSIBLE_WRITE",
      "expected_evidence": [
        "resume_receipt"
      ]
    }
  ],
  "success_contract": [
    "resume continues from a valid checkpoint",
    "completed effects are not duplicated",
