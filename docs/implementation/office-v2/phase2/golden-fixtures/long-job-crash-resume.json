{
  "schema": "velvetos.office-v2.golden-fixture.v0",
  "fixture_id": "long-job-crash-resume",
  "status": "CONTRACT_V0",
  "title": "Long job -> crash -> resume",
  "capability_scope": [
    "long_job.start",
    "checkpoint",
    "failure",
    "resume"
  ],
  "input_contract": {
