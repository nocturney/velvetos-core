{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velvetos://office-v2/phase2/golden-fixture-contract.v0",
  "title": "Office v2 Golden Fixture Contract v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixture_id",
    "status",
    "title",
    "capability_scope",
    "input_contract",
    "semantic_steps",
    "success_contract",
    "evidence_contract",
    "rollback_contract",
    "resource_capture",
    "external_effect_policy"
  ],
  "properties": {
    "schema": {
      "const": "velvetos.office-v2.golden-fixture.v0"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "CONTRACT_V0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "capability_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "input_contract": {
      "type": "object"
    },
    "semantic_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "capability",
          "side_effect_class",
          "expected_evidence"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "side_effect_class": {
            "enum": [
              "NONE",
              "READ",
              "REVERSIBLE_WRITE",
              "IRREVERSIBLE_WRITE"
            ]
          },
          "expected_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "success_contract": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidence_contract": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "rollback_contract": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "resource_capture": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "external_effect_policy": {
      "const": "PROVIDER_ADAPTER_REQUIRED_NO_DIRECT_RUNNER_MUTATION"
    }
  }
}
