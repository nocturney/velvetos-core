{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velvetos.ai3d.engineering-contract.v1",
  "title": "AI3D Engineering Contract v1",
  "description": "Non-authoritative task contract layered above the existing Fabrication Router and velvetos.geometry-ir.v1. Critical hidden dimensions may not be invented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_id",
    "task_ref",
    "capability_record_ids",
    "geometry_ir_schema",
    "units",
    "coordinate_system",
    "datums",
    "expected_bodies",
    "dimensions",
    "functional_interfaces",
    "materials_process",
    "required_outputs",
    "unknowns",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "velvetos.ai3d.engineering-contract.v1"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "capability_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "geometry_ir_schema": {
      "const": "velvetos.geometry-ir.v1"
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_length",
        "normalized_length",
        "angle"
      ],
      "properties": {
        "source_length": {
          "enum": ["mm", "cm", "m", "in", "ft"]
        },
        "normalized_length": {
          "const": "mm"
        },
        "angle": {
          "const": "deg"
        }
      }
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handedness",
        "up_axis",
        "forward_axis",
        "origin_description"
      ],
      "properties": {
        "handedness": {
          "enum": ["right", "left"]
        },
        "up_axis": {
          "enum": ["X", "Y", "Z", "-X", "-Y", "-Z"]
        },
        "forward_axis": {
          "enum": ["X", "Y", "Z", "-X", "-Y", "-Z"]
        },
        "origin_description": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "up_axis": {
                "const": "X"
              },
              "forward_axis": {
                "const": "X"
              }
            },
            "required": ["up_axis", "forward_axis"]
          }
        },
        {
          "not": {
            "properties": {
              "up_axis": {
                "const": "Y"
              },
              "forward_axis": {
                "const": "Y"
              }
            },
            "required": ["up_axis", "forward_axis"]
          }
        },
        {
          "not": {
            "properties": {
              "up_axis": {
                "const": "Z"
              },
              "forward_axis": {
                "const": "Z"
              }
            },
            "required": ["up_axis", "forward_axis"]
          }
        }
      ]
    },
    "datums": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/datum"
      }
    },
    "expected_bodies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/body"
      },
      "minItems": 1
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "functional_interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "materials_process": {
      "$ref": "#/$defs/materialProcess"
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requiredOutput"
      },
      "minItems": 1
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden_dimensions_may_be_invented",
        "printer_network_control",
        "machine_control"
      ],
      "properties": {
        "hidden_dimensions_may_be_invented": {
          "const": false
        },
        "printer_network_control": {
          "const": false
        },
        "machine_control": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "datum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datum_id", "kind", "definition", "evidence_refs"],
      "properties": {
        "datum_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["point", "axis", "plane", "frame"]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_id",
        "role",
        "quantity",
        "representation",
        "watertight_required"
      ],
      "properties": {
        "body_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "representation": {
          "enum": [
            "solid_brep",
            "polygonal_mesh",
            "point_cloud",
            "assembly",
            "drawing",
            "process_artifact"
          ]
        },
        "watertight_required": {
          "type": "boolean"
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "target_ref",
        "nominal",
        "unit",
        "tolerance_minus",
        "tolerance_plus",
        "critical",
        "source_type",
        "evidence_refs",
        "confidence"
      ],
      "properties": {
        "dimension_id": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "nominal": {
          "type": "number"
        },
        "unit": {
          "enum": ["mm", "deg"]
        },
        "tolerance_minus": {
          "type": "number",
          "minimum": 0
        },
        "tolerance_plus": {
          "type": "number",
          "minimum": 0
        },
        "critical": {
          "type": "boolean"
        },
        "source_type": {
          "enum": [
            "user_provided",
            "drawing",
            "manufacturer_spec",
            "measured",
            "derived_from_evidence",
            "assumed",
            "unknown"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "critical": {
                "const": true
              }
            },
            "required": ["critical"]
          },
          "then": {
            "properties": {
              "source_type": {
                "not": {
                  "enum": ["assumed", "unknown"]
                }
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_id",
        "kind",
        "requirements",
        "datum_refs",
        "dimension_refs"
      ],
      "properties": {
        "interface_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "datum_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dimension_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "materialProcessItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "state", "evidence_refs"],
      "properties": {
        "value": {
          "type": ["string", "null"]
        },
        "state": {
          "enum": ["known", "assumed", "unknown"]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "materialProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material", "process", "assumptions"],
      "properties": {
        "material": {
          "$ref": "#/$defs/materialProcessItem"
        },
        "process": {
          "$ref": "#/$defs/materialProcessItem"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/materialProcessItem"
          }
        }
      }
    },
    "requiredOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_id", "artifact_type", "format", "validators"],
      "properties": {
        "output_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "enum": [
            "source",
            "brep",
            "mesh",
            "drawing",
            "manufacturing",
            "slice",
            "report",
            "preview"
          ]
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_id",
        "description",
        "blocking",
        "resolution_required_before"
      ],
      "properties": {
        "unknown_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "resolution_required_before": {
          "enum": [
            "none",
            "geometry_build",
            "manufacturing_release",
            "slice",
            "export"
          ]
        }
      }
    }
  }
}
