# LAB runtime target: Ubuntu 26.04 LTS in the dedicated WSL2 instance OfficeV2-Lab.
OFFICEV2_WSL_DISTRO=OfficeV2-Lab

# Copy these values into LAB-local runtime configuration only after image admission.
# Use an explicitly reviewed immutable image reference, preferably digest-pinned.
OTEL_COLLECTOR_IMAGE=REVIEWED_IMMUTABLE_REFERENCE_REQUIRED

# The admitted WSL instance exposes only the isolated artifact bind at /var/officev2/artifacts.
# Full C:/D: automounts remain disabled.
OFFICEV2_LAB_ARTIFACTS=/var/officev2/artifacts

# Boundary declarations; these are not secrets.
PRODUCTION_CREDENTIALS_ALLOWED=false
OFFICEV2_LAB_ROOT=/opt/officev2-lab
