{
  "name": "velvet-video-toolchain-adapters",
  "version": 2,
  "role": "specialized editing and animation adapters inside the existing Velvet Visual Foundry",
  "noSecondRuntime": true,
  "masterComposer": "hyperframes",
  "finalAuthority": "packages/vfom/HYPERFRAMES-BACKEND.json",
  "editIntelligence": {
    "origin": "https://github.com/browser-use/video-use",
    "integration": "pattern-adapted-not-vendored",
    "status": "implemented",
    "bridge": "scripts/vf_video_edit.py",
    "requestSchema": "packages/vfom/EDIT-EDL.schema.json",
    "features": [
      "audio-first-edl",
      "word-boundary-cut-contract",
      "cut-boundary-inspection-padding",
      "30ms-audio-fades",
      "deterministic-base-cut",
      "render-receipt",
      "boundary-inspection"
    ],
    "transcription": {
      "hardDependencyOnElevenLabs": false,
      "rule": "consume word-timestamp evidence from an approved ASR source when available; do not introduce a new paid transcription authority merely to use editing patterns"
    },
    "selfEvaluation": {
      "maxPasses": 3,
      "inspectRenderedOutput": true,
      "inspectCutBoundaries": true,
      "alsoInspect": [
        "first-2s",
        "last-2s",
        "representative-midpoints"
      ]
    }
  },
  "animationSlots": {
    "hyperframes": {
      "status": "canonical",
      "useFor": [
        "deterministic-hebrew-overlay",
        "kinetic-typography",
        "ui-motion",
        "social-master-composition",
        "multi-shot-composition"
      ]
    },
    "remotion": {
      "origin": "https://github.com/remotion-dev/remotion",
      "versionPolicy": "latest-compatible",
      "reviewedBaselineVersion": "4.0.523",
      "compatibilityGate": "free-license-eligibility+adapter-smoke",
      "status": "free-license-eligible",
      "installByDefault": false,
      "masterRenderer": false,
      "useFor": [
        "react-native-animation-slot",
        "component-heavy-animation",
        "specialized-react-visual"
      ],
      "rule": "Current owner business headcount is 1, so the Remotion Free License covers commercial use and automation. Recheck eligibility if total relevant project headcount reaches 4 or the upstream license changes; output remains subordinate to Foundry QA.",
      "licenseEligibility": {
        "currentVerdict": "FREE_LICENSE_ELIGIBLE",
        "currentBusinessHeadcount": 1,
        "freeLicenseMaxHeadcount": 3,
        "recheckAtHeadcount": 4,
        "commercialUseAllowed": true,
        "automationAllowed": true,
        "source": "https://www.remotion.dev/docs/license/pricing"
      }
    },
    "manim": {
      "origin": "https://github.com/ManimCommunity/manim",
      "versionPolicy": "latest-compatible",
      "minimumVersion": "0.21.0",
      "recoveryVersion": "0.21.0",
      "compatibilityGate": "host-doctor+real-smoke",
      "license": "MIT",
      "python": ">=3.11",
      "status": "host-smoke-verified",
      "installByDefault": false,
      "masterRenderer": false,
      "useFor": [
        "technical-diagram-animation",
        "measurement-explainer",
        "geometry-explainer",
        "process-diagram"
      ],
      "forbiddenAs": [
        "physical-product-proof",
        "customer-result-proof",
        "stress-test-proof"
      ],
      "rule": "render explanatory slot media only; the output is illustrative unless its claims are separately proven",
      "bootstrap": "scripts/bootstrap-manim-host-windows.ps1",
      "hostEvidence": {
        "host": "sderot-windows",
        "python": "3.12",
        "toolchain": "%VELVETOS_RUNTIME_ROOT%\\Toolchains\\manim-0.21.0-py312",
        "evidenceVersion": "0.21.0",
        "evidenceClass": "historical-smoke-artifact",
        "smoke": "1080x1920 technical slot rendered and ffprobe verified",
        "sha256": "8334a878cfa63aaee28e16e74c0e081dd12f1db7096ad6a8e78e3f26690e176a",
        "verifiedAt": "2026-09-14T08:59:22Z"
      },
      "macBootstrap": "scripts/bootstrap-manim-host-macos.sh",
      "macHostEvidence": {
        "host": "sderot-mac",
        "python": "3.12",
        "toolchain": "~/.velvetos/toolchain/manim-py312",
        "evidenceVersion": "0.21.0",
        "evidenceClass": "historical-smoke-artifact",
        "smoke": "1080x1920 technical slot rendered and ffprobe verified",
        "sha256": "5c838d189315c9efc8b58cf1b88813a4a72ede21de96e990df2db71fdbc887fe",
        "verifiedAt": "2026-10-04T06:19:14Z"
      }
    }
  },
  "productMotion": {
    "realPrintFileTurntable": {
      "status": "implemented",
      "bridge": "scripts/vf_turntable.py",
      "geometrySource": "real print file only",
      "formats": [
        ".3mf",
        ".stl",
        ".obj",
        ".glb",
        ".gltf",
        ".blend"
      ],
      "durationSeconds": {
        "min": 6,
        "max": 8
      },
      "canvas": "1080x1920@30fps",
      "scene": "warm-interior lighting around source-truth geometry",
      "colorModes": [
        "embedded",
        "verified-hex"
      ],
      "rule": "never AI-generate or repair the product; turntable is illustrative and never a publish receipt"
    }
  },
  "guardrails": {
    "mediaVaultRemainsSourceOfTruth": true,
    "contentContractRemainsAuthority": true,
    "claimProvenanceRemainsAuthority": true,
    "noGeneratedAssetProvesPhysicalClaim": true,
    "hebrewVisualTextUsesDeterministicOverlay": true,
    "renderReceiptIsNotPublishReceipt": true,
    "noRuntimeAutoInstallDuringContentJob": true
  },
  "brandAssets": {
    "tokens": "packages/vfbrand/brand-tokens.json",
    "verifiedBrandFonts": [
      "packages/vfbrand/assets/fonts/rubik/Rubik-VariableFont_wght.ttf",
      "packages/vfbrand/assets/fonts/cinzel/Cinzel-VariableFont_wght.ttf"
    ],
    "logo": "packages/vfbrand/assets/logo/velvet-factory-logo-gold-full-lockup-traced.svg",
    "decision": "owner decision 2026-09-28"
  }
}
