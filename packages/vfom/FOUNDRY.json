{
  "name": "velvet-visual-foundry",
  "version": 2,
  "role": "machine-readable creative orchestration policy over existing VelvetOS packs",
  "noSecondRuntime": true,
  "specialists": {
    "creativeDirector": ".cursor/skills/velvet-creative-director/SKILL.md",
    "brandGuardian": ".cursor/skills/velvet-brand-guardian/SKILL.md",
    "mediaLibrarian": ".cursor/skills/velvet-media-librarian/SKILL.md"
  },
  "sharedAuthorities": {
    "visualConstitution": "packages/vfom/VISUAL-OS.md",
    "visualDNA": "packages/vfom/VISUAL-DNA.json",
    "creativeManifestSchema": "packages/vfom/CREATIVE-MANIFEST.schema.json",
    "contentContractSchema": "packages/vfom/CONTENT-CONTRACT.schema.json",
    "motionPresets": "packages/vfom/MOTION-PRESETS.md",
    "formatGenomes": "packages/vfom/FORMAT-GENOMES.md",
    "mediaCatalog": "packages/vfmedia/catalog.json"
  },
  "layers": {
    "creativeIntelligence": [
      "creative-director",
      "brand-guardian",
      "media-librarian",
      "proof-first-storyboarder",
      "visual-evaluator",
      "repair-planner",
      "experiment-director"
    ],
    "orchestration": [
      "content-job-state-machine",
      "content-contract",
      "creative-manifest",
      "opportunity-scoring",
      "progressive-variants",
      "threshold-policy",
      "budget-governor",
      "retry-and-escalation"
    ],
    "deterministicServices": [
      "vfmedia-catalog",
      "claim-provenance",
      "subject-packs",
      "ffmpeg-svg-caption-composition",
      "render-derivatives",
      "drive-storage",
      "vfigos-publish-verification",
      "vfinsights-performance-evidence"
    ]
  },
  "creativeManifest": {
    "enabled": true,
    "schema": "packages/vfom/CREATIVE-MANIFEST.schema.json",
    "role": "single per-content-job coordination artifact shared by creative direction, media selection, edit, cover, QA, feed continuity and publish handoff",
    "notASecondStateMachine": true,
    "notAMediaCatalog": true,
    "notAClaimAuthority": true
  },
  "stateMachine": [
    "discovered",
    "qualified",
    "contracted",
    "concepted",
    "storyboarded",
    "media_ready",
    "rough_generated",
    "visually_scored",
    "repaired",
    "rendered",
    "authorized_for_tool_publish",
    "published_verified",
    "performance_learned",
    "ready_for_publish",
    "waiting_for_media",
    "human_required",
    "archived"
  ],
  "truth": {
    "levels": ["verified_real", "derived_real", "illustrative_ai", "synthetic", "unverified"],
    "defaultWhenMissing": "unverified",
    "claimRule": "factual public claims require verified evidence; illustrative_ai and synthetic assets may never prove a physical result",
    "syntheticDefaultAllowed": ["background", "transition", "atmosphere", "supporting_visual"],
    "syntheticDefaultForbidden": ["measurement", "stress_test_result", "product_geometry_claim", "customer_result", "failure_or_success_claim"]
  },
  "audioPolicy": {
    "requiredForVideo": true,
    "skill": ".cursor/skills/vf-ig-music/SKILL.md",
    "playbook": "packages/vfresearch/MUSIC.md",
    "allowedModes": ["source", "music", "sfx", "source_plus_music", "source_plus_sfx", "intentional_silence"],
    "defaultSilence": "fail",
    "nearSilent": "fail",
    "intentionalSilenceRequiresReason": true,
    "checks": ["stream_presence", "loudness", "noise_and_clipping", "sync", "story_fit", "ducking_when_needed"],
    "rule": "A Reel or video Story cannot pass exact-final QA merely because an audio stream exists. Missing or near-silent audio routes to audio repair unless intentional silence is explicitly justified and reviewed."
  },
  "visualCopyPolicy": {
    "requiredForHebrewVisualText": true,
    "skill": ".cursor/skills/vf-hebrew-copy/SKILL.md",
    "authority": "packages/vfcopy/skills/velvet-hebrew-copy/SKILL.md",
    "pipeline": "packages/vfcopy/skills/velvet-hebrew-copy/PIPELINE.md",
    "readerFirst": "packages/vfcopy/hq/reader-first-he.md",
    "humanizer": "packages/vfcopy/hq/ai-tells-he.md",
    "candidateMin": 3,
    "candidateMax": 5,
    "noTextBaselineRequired": true,
    "defaultWhenTextAddsNoValue": "NO_TEXT",
    "failPatterns": ["generic_slogan", "describes_visible_image_only", "bakery_test_failure", "fake_profundity", "text_added_only_to_fill_space"],
    "ownerExplicitPreference": "strong-evidence-preserve-point-and-voice",
    "rule": "Every Hebrew first-frame hook, cover headline or overlay must pass reader-first, velvet-hebrew-copy and Humanizer/AI-tells, and must beat a clean NO_TEXT baseline. Technical typography/contrast alone cannot make weak copy pass."
  },
  "rightsPolicy": {
    "scope": "operational publish gating, not legal advice",
    "ownerCapturedShowcase": "Owner-captured footage/stills of a printed object do not require a separate generic media-rights approval gate when no third-party media, UGC, identifiable person/privacy issue or known restriction is present.",
    "modelLicenseDefault": "not-a-showcase-publish-gate",
    "modelLicenseEscalatesWhen": ["public-content-explicitly-offers-the-depicted-model-for-sale", "paid-promotion-of-the-depicted-model", "known-license-restriction-or-dispute"],
    "privateInbound": "Private inbound conversations are handled separately from public editorial/showcase framing."
  },
  "progressiveVariants": {
    "enabled": true,
    "maxConceptCandidates": 12,
    "maxStoryboardCandidates": 6,
    "maxRoughCuts": 4,
    "maxFinalRenders": 2,
    "maxRepairCycles": 3,
    "rule": "never spend a full-quality render on an unranked concept when a cheaper preview can reject it"
  },
  "evaluation": {
    "deterministic": ["aspect_ratio", "resolution", "safe_zones", "subtitle_bounds", "audio_stream_presence", "audio_loudness", "audio_sync", "frame_integrity"],
    "perceptualRubrics": ["brand", "hook", "composition", "reality", "originality", "audio_story_fit", "visual_copy_specificity", "visual_copy_value_over_no_text"],
    "referenceChecks": ["subject_fidelity", "material_fidelity", "geometry_invariants"],
    "artifactChecks": ["flicker", "malformed_geometry", "unreadable_text", "temporal_jitter", "audio_clipping_or_noise"],
    "routineThresholds": {"brand": 80, "reality": 90, "artifact": 90},
    "heroThresholds": {"brand": 85, "reality": 95, "artifact": 92}
  },
  "novelty": {
    "enabled": true,
    "dimensions": ["product", "first_frame", "proof_mechanic", "story_structure", "camera_angle", "reference_mechanic"],
    "reviewSimilarity": 0.78,
    "rejectSimilarity": 0.90,
    "defaultCooldownDays": 14,
    "allowSeriesOverride": true
  },
  "learning": {
    "storeRecipeWithPerformanceEvidence": true,
    "memoryAuthority": "existing office-learning + vfinsights; no second creative memory database",
    "minimumMeasuredPostsBeforeStyleRecommendation": 3,
    "explorationPolicy": {"exploit": 0.70, "controlledVariation": 0.20, "experimental": 0.10}
  },
  "budget": {
    "mode": "bounded",
    "noInventedMoney": true,
    "preferRealFootage": true,
    "reuseApprovedAssetsBeforeGeneration": true,
    "skipWeakConceptsBeforeRender": true
  },
  "humanSurface": {
    "mode": "exception-only",
    "creativeQualityFailure": "auto-repair",
    "routineCreativeChoice": "office",
    "humanRequired": [
      "physical-footage-or-staging",
      "rights-or-privacy-unclear",
      "sale-ils-or-price-change",
      "purchase-or-spend",
      "boost-or-ads",
      "customer-whatsapp-send",
      "print-from-hq",
      "irreversible-destructive-action",
      "hard-blocker-after-failover"
    ],
    "rightsOrPrivacyMeaning": "third-party media, UGC, identifiable-person/privacy issues or a known rights restriction; not a blanket model-license gate for owner-captured showcase content"
  }
}
