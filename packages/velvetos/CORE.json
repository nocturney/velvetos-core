{
  "product": "VelvetOS",
  "role": "core",
  "displayName": "VelvetOS Core",
  "updatedAt": "2026-09-07",
  "layers": {
    "adr": "packages/velvetos/ADR-THREE-LAYERS.md",
    "doc": "packages/velvetos/LAYERS.md",
    "edge": "optional host/floor nerves — local buffer, sync, degraded local — not this repo name",
    "kernel": "this repository — laws, seats, packs, modules, event contracts, computational sensors",
    "office": "desk + instance frontend — business decisions, CRM views, send via tools, retro→signal"
  },
  "metaphor": {
    "core": "backend — shared OS kernel (laws, seats, packs, modules, sensors); Kernel layer, not a nervous-system runtime",
    "instance": "frontend — one business office that enables modules and binds live tools (Office layer)"
  },
  "events": {
    "catalog": "packages/velvetos/schema/events.catalog.json",
    "envelope": "packages/velvetos/schema/event-envelope.schema.json",
    "rule": "Disk/checkpoint contracts only — no message broker"
  },
  "repos": {
    "core": "this repository (VelvetOS Core)",
    "instances": [
      {
        "id": "velvet-factory",
        "displayName": "VelvetOS — Velvet Factory",
        "scaffold": "instances/velvet-factory/",
        "github": "nocturney/velvetos-velvet-factory",
        "status": "scaffold-ready",
        "note": "Create the empty GitHub repo, then run scripts/publish-instance.sh velvet-factory"
      },
      {
        "id": "beauty-multi-ig",
        "displayName": "VelvetOS — <Beauty Business>",
        "preset": "beauty-multi-ig",
        "status": "preset-only"
      },
      {
        "id": "clinical-legal-opinions",
        "displayName": "VelvetOS — <Psychiatrist Business>",
        "preset": "clinical-legal-opinions",
        "status": "preset-only"
      }
    ]
  },
  "rule": "This repository is VelvetOS Core (backend). Business offices are separate instance repos (frontend) that pull modules from core.",
  "instanceResolution": {
    "resolver": "packages/velvetos/instance_resolver.py",
    "instanceIdEnvironment": "VELVETOS_INSTANCE_ID",
    "manifestPattern": "instances/{instanceId}/INSTANCE.json",
    "currentWorkspaceManifest": "INSTANCE.json",
    "surfaceMap": "INSTANCE.json#surfaces",
    "requireExplicitInstanceIdWhenRunningFromCore": true,
    "silentBusinessDefaultForbidden": true
  },
  "toolStatusResolution": {
    "contract": "packages/velvetos/tool-status-contract.json",
    "resolver": "packages/velvetos/tool_status_resolver.py",
    "instanceSurface": "toolStatus",
    "activeAuthority": "instance:surface:toolStatus",
    "rollbackCompatibilityPath": "packages/velvetos/TOOL-STATUS.json",
    "consumerCutover": true,
    "rollbackCompatibilityRetained": true,
    "silentBusinessDefaultForbidden": true
  },
  "sampleProfiles": {
    "path": "packages/velvetos/samples/",
    "runtimeAuthority": false,
    "purpose": "documentation-and-rollback-compatibility-only",
    "runtimeResolution": "instanceResolution"
  }
}
