{
  "schema": "velvetos.upstream-watch.v1",
  "updatedAt": "2026-09-27",
  "authority": "owner-explicit",
  "purpose": "Track update signals for installed tools and repository-only skills/agents/pattern sources without auto-upgrading or version-locking normal work.",
  "policy": {
    "default": "latest-compatible",
    "autoUpgrade": false,
    "exactVersionUse": [
      "rollback",
      "recovery",
      "reproducibility",
      "artifact-proof"
    ],
    "normalExecution": "capability-and-smoke evidence wins; newer compatible versions are allowed",
    "incompatibleUpdate": "report and keep current known-good runtime until compatibility repair is reviewed",
    "frozenTools": "do not monitor for upgrades unless owner explicitly unfreezes",
    "pendingUpdates": "sticky-until-explicit-reviewed-adoption-ack",
    "adoptionAck": "python3 scripts/vf_upstream_watch.py ack --repo <owner/repo> --evidence <compatibility/adoption receipt>"
  },
  "scheduler": {
    "owner": "velvet-research-seat",
    "existingCadence": "daily 02:00 Asia/Jerusalem",
    "newRoutine": false,
    "consumer": "velvetos-office-loop",
    "report": "packages/vfresearch/sources/upstream-watch-latest.json"
  },
