{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velvetos://policy/sensor-selection.schema.json",
  "title": "VelvetOS Sensor Selection",
  "type": "object",
  "required": [
    "schema_version", "mode", "registry", "unknown_path_behavior",
    "broad_change_behavior", "always_on_source", "broad_change_patterns",
    "neutral_change_patterns", "machine_write_routing",
    "shadow_exit", "evidence", "stage3_preparation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["shadow", "enforced"]},
    "registry": {"const": "packages/velvetos/policy/sensor-registry.json"},
    "unknown_path_behavior": {"const": "FULL_SUITE"},
    "broad_change_behavior": {"const": "FULL_SUITE"},
    "always_on_source": {"const": "sensor_registry_fallback_scope"},
    "broad_change_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "neutral_change_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "machine_write_routing": {
      "type": "object",
      "required": [
        "state_data_patterns", "domain_artifact_patterns", "post_push_full_suite_classes"
      ],
      "additionalProperties": false,
      "properties": {
        "state_data_patterns": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "domain_artifact_patterns": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "post_push_full_suite_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["AUTHORITY_SECURITY", "CODE_CONTRACT", "DOMAIN_ARTIFACT", "STATE_DATA"]}
        }
      }
    },
    "shadow_exit": {
      "type": "object",
      "required": [
        "minimum_pull_requests", "minimum_observation_days", "maximum_critical_misses",
        "noncritical_miss_requires_classification",
        "noncritical_relevant_miss_requires_mapping_update",
        "deterministic_replay_required", "rollback_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "minimum_pull_requests": {"type": "integer", "minimum": 1},
        "minimum_observation_days": {"type": "integer", "minimum": 1},
        "maximum_critical_misses": {"const": 0},
        "noncritical_miss_requires_classification": {"const": true},
        "noncritical_relevant_miss_requires_mapping_update": {"const": true},
        "deterministic_replay_required": {"const": true},
        "rollback_mode": {"const": "FULL_SUITE_REQUIRED"}
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "persist_in_github_job_summary",
        "emit_machine_readable_log_marker",
        "repository_mutation_from_shadow"
      ],
      "additionalProperties": false,
      "properties": {
        "persist_in_github_job_summary": {"const": true},
        "emit_machine_readable_log_marker": {"const": true},
        "repository_mutation_from_shadow": {"const": false}
      }
    },
    "stage3_preparation": {
      "type": "object",
      "required": [
        "state", "activation_requires_shadow_exit_eligible", "activation_receipt",
        "pull_request_execution", "main_push_execution",
        "machine_writer_precheck_execution", "machine_writer_post_push_execution",
        "selected_suite_runner", "critical_always_on_preserved", "unknown_or_broad_change_behavior",
        "duplicate_direct_invocations_to_remove", "required_status_check",
        "branch_ruleset_id", "branch_ruleset_target_enforcement",
        "activation_duration_override", "rollback_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["PREPARED_NOT_ACTIVE", "ACTIVE"]},
        "activation_requires_shadow_exit_eligible": {"const": true},
        "activation_receipt": {"const": "packages/velvetos/policy/reports/stage3-activation-receipt.json"},
        "pull_request_execution": {"const": "SELECTED_SUITE"},
        "main_push_execution": {"const": "FULL_SUITE"},
        "machine_writer_precheck_execution": {"const": "SELECTED_OR_FULL_BY_RISK"},
        "machine_writer_post_push_execution": {"const": "REUSE_EXACT_SHA_PRECHECK_EXCEPT_AUTHORITY_SECURITY"},
        "selected_suite_runner": {"const": "scripts/check-all.py --selection sensor-selection.json"},
        "critical_always_on_preserved": {"const": true},
        "unknown_or_broad_change_behavior": {"const": "FULL_SUITE"},
        "duplicate_direct_invocations_to_remove": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_status_check": {"const": "check-all"},
        "branch_ruleset_id": {"type": "integer", "minimum": 1},
        "branch_ruleset_target_enforcement": {"const": "active"},
        "activation_duration_override": {
          "type": "object",
          "required": [
            "type", "criterion", "authorized_by", "authorized_at", "reason",
            "minimum_observed_days", "minimum_observed_pull_requests",
            "requires_only_blocker", "requires_zero_critical_misses",
            "requires_zero_unclassified_noncritical_misses",
            "requires_zero_incomplete_observations", "requires_run_history_complete",
            "requires_deterministic_replay_pass"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "OWNER_DURATION_ONLY"},
            "criterion": {"const": "minimum_observation_days"},
            "authorized_by": {"const": "owner"},
            "authorized_at": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1},
            "minimum_observed_days": {"type": "number", "minimum": 0},
            "minimum_observed_pull_requests": {"type": "integer", "minimum": 1},
            "requires_only_blocker": {"const": "MINIMUM_OBSERVATION_DAYS_NOT_MET"},
            "requires_zero_critical_misses": {"const": true},
            "requires_zero_unclassified_noncritical_misses": {"const": true},
            "requires_zero_incomplete_observations": {"const": true},
            "requires_run_history_complete": {"const": true},
            "requires_deterministic_replay_pass": {"const": true}
          }
        },
        "rollback_mode": {"const": "FULL_SUITE_REQUIRED"}
      }
    }
  }
}
