{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velvetos.cost-envelope.v1",
  "title": "VelvetOS bounded cost envelope",
  "description": "Owner-approved bounded authorization for repeated paid-capable calls under policy_id cost.recurring.new.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","envelope_id","policy_id","classification","provider","product_or_plan","billing_model","usage_model","scope","cap","overage","meter_max_age_seconds","source_preflight","approval"],
  "properties": {
    "schema": {"const": "velvetos.cost-envelope.v1"},
    "envelope_id": {"type": "string","minLength": 1},
    "policy_id": {"const": "cost.recurring.new"},
    "classification": {"enum": ["EXISTING_PAID_CAPABILITY","FREE_TIER_LIMITED","PAID_REQUIRED"]},
    "provider": {"type": "string","minLength": 1},
    "product_or_plan": {"type": "string","minLength": 1},
    "billing_model": {"type": "string","minLength": 1},
    "usage_model": {"type": "string","minLength": 1},
    "scope": {
      "type": "object","additionalProperties": false,
      "required": ["component","environment","actions"],
      "properties": {
        "component": {"type": "string","minLength": 1},
        "environment": {"type": "string","minLength": 1},
        "actions": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"type": "string","minLength": 1}}
      }
    },
    "cap": {
      "type": "object","additionalProperties": false,
      "required": ["amount","currency","period","hard_cap_enforced"],
      "properties": {
        "amount": {"type": "number","exclusiveMinimum": 0},
        "currency": {"const": "ILS"},
        "period": {"type": "string","minLength": 1},
        "hard_cap_enforced": {"const": true}
      }
    },
    "overage": {
      "type": "object","additionalProperties": false,
      "required": ["behavior","automatic_paid_overage_allowed"],
      "properties": {
        "behavior": {"const": "BLOCK_AT_CAP"},
        "automatic_paid_overage_allowed": {"type": "boolean"}
      }
    },
    "meter_max_age_seconds": {"type": "integer","minimum": 60,"maximum": 86400},
    "source_preflight": {
      "type": "object","additionalProperties": false,
      "required": ["path","sha256"],
      "properties": {
        "path": {"type": "string","minLength": 1},
        "sha256": {"type": "string","pattern": "^[a-f0-9]{64}$"}
      }
    },
    "approval": {
      "type": "object","additionalProperties": false,
      "required": ["approved_by","approved_at","expires_at","approval_ref"],
      "properties": {
        "approved_by": {"type": "string","minLength": 1},
        "approved_at": {"type": "string","format": "date-time"},
        "expires_at": {"type": "string","format": "date-time"},
        "approval_ref": {"type": "string","minLength": 1}
      }
    }
  }
}
