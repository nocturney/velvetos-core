{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velvetos://policy/instagram-publish-context.schema.json",
  "title": "instagram.publish evaluation context",
  "type": "object",
  "required": [
    "channel",
    "publication_type",
    "mutation_tool",
    "content_id",
    "package_sha256",
    "copy_sha256",
    "media_sha256s",
    "risk_class",
    "standing_authorization",
    "forbidden_effects",
    "gates"
  ],
  "properties": {
    "channel": {"const": "instagram"},
    "publication_type": {"const": "organic"},
    "mutation_tool": {"type": "string", "minLength": 1},
    "content_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,120}$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "copy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "media_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "standing_authorization": {"type": "boolean"},
    "forbidden_effects": {"type": "array", "items": {"type": "string"}},
    "gates": {
      "type": "object",
      "required": [
        "transport",
        "visible_text",
        "exact_final_preflight",
        "visual_standard",
        "rights_privacy",
        "brand",
        "product_truth"
      ],
      "additionalProperties": false,
      "properties": {
        "transport": {"enum": ["PASS", "NOT_APPLICABLE", "FAIL"]},
        "visible_text": {"enum": ["PASS", "NOT_APPLICABLE", "FAIL"]},
        "exact_final_preflight": {"enum": ["PASS", "NOT_APPLICABLE", "FAIL"]},
        "visual_standard": {"enum": ["PASS", "NOT_APPLICABLE", "FAIL"]},
        "rights_privacy": {"enum": ["PASS", "NOT_APPLICABLE", "FAIL"]},
        "brand": {"enum": ["PASS", "NOT_APPLICABLE", "FAIL"]},
        "product_truth": {"enum": ["PASS", "NOT_APPLICABLE", "FAIL"]}
      }
    },
    "human_approval": {"type": ["object", "null"]},
    "legacy_authorization": {"type": ["object", "null"]},
    "job_created_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
