{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velvet.content_ready.v1",
  "title": "VelvetOS CONTENT_READY evidence envelope",
  "description": "Aggregates exact artifact identity and publication-readiness evidence. This envelope is evidence only; policy_id instagram.publish remains the sole publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "bindings",
    "evidence",
    "repair_targets",
    "retry_targets",
    "hard_blockers",
    "owner_surface",
    "validated_at"
  ],
  "properties": {
    "schema_version": {"const": "velvet.content_ready.v1"},
    "status": {"enum": ["PASS", "FAIL"]},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "package_sha256", "copy_sha256", "media_sha256s"],
      "properties": {
        "content_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,120}$"},
        "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "copy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_truth",
        "brand",
        "copy",
        "visual_qa",
        "rights_privacy",
        "render_transport"
      ],
      "properties": {
        "product_truth": {"$ref": "#/$defs/evidence"},
        "brand": {"$ref": "#/$defs/evidence"},
        "copy": {"$ref": "#/$defs/evidence"},
        "visual_qa": {"$ref": "#/$defs/evidence"},
        "rights_privacy": {"$ref": "#/$defs/evidence"},
        "render_transport": {"$ref": "#/$defs/evidence"}
      }
    },
    "repair_targets": {
      "type": "array",
      "items": {"enum": ["product_truth", "brand", "copy", "visual_qa"]},
      "uniqueItems": true
    },
    "retry_targets": {
      "type": "array",
      "items": {"enum": ["render_transport"]},
      "uniqueItems": true
    },
    "hard_blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "owner_surface": {"enum": ["NONE", "HARD_BLOCKER"]},
    "validated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ref", "sha256", "failure_mode"],
      "properties": {
        "status": {"enum": ["PASS", "NOT_APPLICABLE", "FAIL", "UNKNOWN"]},
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "failure_mode": {
          "type": ["string", "null"],
          "enum": ["REPAIRABLE_QUALITY", "RETRYABLE_RUNTIME", "HARD_BLOCKER", null]
        },
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
