{
  "schema_version": 1,
  "registry_kind": "velvetos_state_evidence_model",
  "status": "ACTIVE_STAGE7A",
  "scope": {
    "purpose": "Classify state-bearing, proof, authorization-decision, and historical operational artifacts without creating a new store.",
    "includes": "Operational current-state surfaces, receipts/evidence, external-effect authorization decisions, append-only/history artifacts, and retention-registry artifact classes.",
    "excludes": "Source code, ordinary static documentation, test fixtures, and binary assets unless a listed surface or retention class explicitly assigns a semantic role.",
    "storage_change": "NONE_STAGE7A",
    "migration_change": "NONE_STAGE7A",
    "deletion_authorized": false
  },
  "invariants": {
    "exactly_four_categories": true,
    "one_canonical_owner_per_domain": true,
    "compatibility_paths_are_not_authority": true,
    "projections_are_not_authority_outside_their_narrow_domain": true,
    "evidence_never_authorizes_external_effect": true,
    "authorization_decision_is_distinct_from_evidence": true,
    "audit_history_never_overwrites_current_state": true,
    "superseded_current_state_becomes_history": true,
    "no_new_database": true
  },
  "categories": [
    {
      "id": "CANONICAL_STATE",
      "definition": "Current authoritative representation for one bounded domain or the canonical current index for that domain. Its authority never expands beyond the declared authority_scope.",
      "can_authorize_external_effect": false,
      "may_be_current": true,
      "append_only": false
    },
    {
      "id": "EVIDENCE_RECEIPT",
      "definition": "Proof or observation about state/action/runtime/provider results. Evidence can satisfy a required evidence input but cannot itself decide an external effect.",
      "can_authorize_external_effect": false,
      "may_be_current": false,
      "append_only": true
    },
    {
      "id": "AUTHORIZATION_DECISION",
      "definition": "A policy-bound decision for an exact external effect/action. It is valid only through the canonical policy decision path and exact-action receipt contract.",
      "can_authorize_external_effect": true,
      "may_be_current": false,
      "append_only": true
    },
    {
      "id": "AUDIT_HISTORY",
      "definition": "Historical, superseded, append-only, or generated record retained for reconstruction/audit. It cannot overwrite current canonical state or mint authorization.",
      "can_authorize_external_effect": false,
      "may_be_current": false,
      "append_only": true
    }
  ],
  "retention_defaults": [
    {
      "artifact_class_id": "canonical-policy-config-schema",
      "category": "CANONICAL_STATE",
      "lifecycle": "current policy/config/schema is canonical for its declared configuration domain"
    },
    {
      "artifact_class_id": "compact-audit-receipts",
      "category": "EVIDENCE_RECEIPT",
      "lifecycle": "proof by default; exact-action authorization receipts are overridden by schema identity"
    },
    {
      "artifact_class_id": "harness-checkpoints",
      "category": "CANONICAL_STATE",
      "lifecycle": "one current checkpoint per task_id; superseded checkpoints transition to AUDIT_HISTORY"
    },
    {
      "artifact_class_id": "office-generated-output",
      "category": "AUDIT_HISTORY",
      "lifecycle": "generated output is history unless separately referenced as evidence"
    },
    {
      "artifact_class_id": "publish-bridge-archive",
      "category": "AUDIT_HISTORY",
      "lifecycle": "provider/publication archive is immutable history; individual live-readback records may be referenced as evidence"
    },
    {
      "artifact_class_id": "creative-render-output",
      "category": "AUDIT_HISTORY",
      "lifecycle": "render outputs are generated history unless a receipt binds their digest as evidence"
    },
    {
      "artifact_class_id": "approved-visual-reference",
      "category": "CANONICAL_STATE",
      "lifecycle": "current approved reference is canonical only for visual-reference identity"
    },
    {
      "artifact_class_id": "vfmedia-operational-data",
      "category": "CANONICAL_STATE",
      "lifecycle": "current runner/pending state is canonical; event logs are explicitly overridden to AUDIT_HISTORY"
    },
    {
      "artifact_class_id": "research-evidence",
      "category": "EVIDENCE_RECEIPT",
      "lifecycle": "source-grounded research evidence with provenance; never self-promotes into state or policy"
    }
  ],
