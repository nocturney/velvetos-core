{
  "schemaVersion": 1,
  "policy": {
    "mode": "single-source-of-truth",
    "driftBehavior": "fail-closed",
    "runtimeJobsMaySelfUpgrade": false,
    "upgradeRule": "review upstream release notes and compatibility, update this manifest once, then run all sensors and host smoke checks"
  },
  "components": {
