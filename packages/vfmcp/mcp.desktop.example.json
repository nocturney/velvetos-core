{
  "_comment": "Copy the servers you need into ~/.cursor/mcp.json (user global) or Codespace MCP config. Do NOT paste secrets into this repo's .cursor/mcp.json. Do NOT commit filled copies. Instagram canonical = adelaidasofia/instagram-mcp. This file = stdio DEV/FALLBACK. Cloud/remote HTTP = mcp.cloud.example.json + REMOTE.md.",
  "mcpServers": {
    "mcp-gsheets": {
      "command": "npx",
      "args": ["-y", "mcp-gsheets@latest"],
      "env": {
        "GOOGLE_PROJECT_ID": "${env:GOOGLE_PROJECT_ID}",
        "GOOGLE_APPLICATION_CREDENTIALS": "${env:GOOGLE_APPLICATION_CREDENTIALS}"
      }
    },
    "whatsapp": {
      "command": "uv",
      "args": [
        "--directory",
        "/ABS/PATH/whatsapp-mcp/whatsapp-mcp-server",
        "run",
        "main.py"
      ]
    },
    "instagram": {
      "command": "instagram-mcp",
      "env": {
        "INSTAGRAM_MCP_ACCESS_TOKEN": "${env:INSTAGRAM_MCP_ACCESS_TOKEN}",
        "INSTAGRAM_MCP_IG_USER_ID": "${env:INSTAGRAM_MCP_IG_USER_ID}"
      }
    },
    "icloud": {
      "command": "icloud-drive-mcp-server",
      "env": {
        "ICLOUD_MCP_ROOT": "/Users/YOU/Library/Mobile Documents/com~apple~CloudDocs/Velvet Factory",
        "ICLOUD_MCP_WRITE": "false"
      }
    }
  }
}
