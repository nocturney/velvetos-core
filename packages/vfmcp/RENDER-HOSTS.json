{
  "version": 2,
  "authority": "packages/vfmcp/HOST.md",
  "purpose": "canonical Edge/Office execution hosts for local render and speech capabilities",
  "routing": {
    "strategy": "primary-then-fallback",
    "primaryHost": "sderot-mac",
    "fallbackHosts": ["sderot-win"],
    "failoverTrigger": "host_unreachable_or_doctor_failure",
    "stickyPerJob": true,
    "noParallelExecutionForSameJob": true,
    "qaThresholdsMayNotDegradeOnFallback": true
  },
  "hosts": {
    "sderot-mac": {
      "displayName": "Mac-Office",
      "location": "Sderot",
      "platform": "macOS",
      "workerName": "sderot-mac",
      "repoPath": "~/velvetos-core",
      "priority": 10,
      "roles": ["subscription-host", "edge-worker", "video-render-host", "speech-host"],
      "renderBackend": "packages/vfom/HYPERFRAMES-BACKEND.json",
      "speechBackend": "packages/vfom/SPEECH-BACKEND.json",
      "bootstrap": "scripts/bootstrap-hyperframes-host-macos.sh",
      "speechBootstrap": "scripts/bootstrap-speech-host-macos.sh",
      "localState": "~/.velvetos/render-host.json",
      "speechLocalState": "~/.velvetos/speech-host.json",
      "toolchainManifest": "packages/vfmcp/TOOLCHAIN-VERSIONS.json",
      "route": "cursor-agent-worker",
      "inboundPortRequired": false,
      "status": "host_smoke_verified",
      "verifiedEvidence": "real local HyperFrames smoke render completed with ffprobe receipt and canonical Cursor worker running on Mac-Office on 2026-09-12",
      "productionPromotionPending": ["approved_media_vault_asset_render_and_existing_qa", "intentional_hyperframes_failure_and_ffmpeg_failover_verification"],
      "promotionRule": "backend live_verified only after host smoke + real approved asset render + existing QA + failover verification"
    },
    "sderot-win": {
      "displayName": "Windows-Office",
      "location": "Sderot",
      "platform": "Windows",
      "workerName": "sderot-win",
      "repoPath": "%USERPROFILE%\\velvetos-core",
      "priority": 20,
      "roles": ["edge-worker", "video-render-host", "speech-host", "fallback-host"],
      "renderBackend": "packages/vfom/HYPERFRAMES-BACKEND.json",
      "speechBackend": "packages/vfom/SPEECH-BACKEND.json",
      "bootstrap": "scripts/bootstrap-media-host-windows.ps1",
      "localState": "%USERPROFILE%\\.velvetos\\render-host.json",
      "speechLocalState": "%USERPROFILE%\\.velvetos\\speech-host.json",
      "toolchainManifest": "packages/vfmcp/TOOLCHAIN-VERSIONS.json",
      "route": "cursor-agent-worker",
      "inboundPortRequired": false,
      "computePolicy": {
        "hyperframes": "native-windows",
        "speech": "cpu-on-windows-amd",
        "rocm": false,
        "note": "VoiceStudio on Windows uses CPU for AMD GPUs; ROCm remains Linux-only."
      },
      "status": "configured_host_smoke_pending",
      "verifiedEvidence": null,
      "promotionRule": "fallback_ready only after Windows bootstrap doctor + HyperFrames smoke receipt + VoiceStudio API doctor + worker registration"
    }
  },
  "defaultRenderHost": "sderot-mac",
  "defaultSpeechHost": "sderot-mac"
}
