{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vfharness-checkpoint",
  "title": "VF harness task checkpoint",
  "type": "object",
  "required": ["task_id", "status", "pack", "completed_steps", "next_step", "artifacts", "unresolved", "last_updated"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["running", "blocked", "escalated", "done"] },
    "pack": { "type": "string", "minLength": 1 },
    "crew": {
      "type": "string",
      "description": "Existing vfe2b crew when this checkpoint backs a משמרת (morning-brief, inquiry, content, research, books-data)."
    },
    "planned_steps": {
      "type": "array",
      "description": "Plan preview before execution — coordinator pattern from Open Multi-Agent, without a second runtime.",
      "items": { "type": "string" },
      "maxItems": 8
    },
    "completed_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_step": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outcome": {
      "type": ["string", "null"],
      "enum": ["worker_done", "escalation", "decision_gate", null],
      "description": "Run card מצב when the משמרת closes or pauses on a durable gate."
    },
    "pulse": {
      "type": "string",
      "enum": ["working", "blocked", "idle"],
      "description": "Run card דופק — herdr pattern on the same card."
    },
    "verification": {
      "type": "string",
      "description": "Run card אימות — sensor name, named field read, or חסר."
    },
    "gate": {
      "type": ["object", "null"],
      "description": "Durable pause until a human or lead seat clears the gate. Checkpoint stays blocked; do not emit worker_done.",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["decision_gate", "escalation", "approval"] },
        "waiting_for": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      },
      "required": ["kind", "waiting_for"]
    },
    "escalation": { "type": ["string", "null"] },
    "last_updated": { "type": "string", "minLength": 8 }
  }
}
