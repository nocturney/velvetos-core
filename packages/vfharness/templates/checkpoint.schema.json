{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vfharness-checkpoint",
  "title": "VF harness task checkpoint",
  "type": "object",
  "required": ["task_id", "status", "pack", "completed_steps", "next_step", "artifacts", "unresolved", "last_updated"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["running", "blocked", "escalated", "done"] },
    "pack": { "type": "string", "minLength": 1 },
    "completed_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_step": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "escalation": { "type": ["string", "null"] },
    "last_updated": { "type": "string", "minLength": 8 },
    "events": {
      "type": "array",
      "description": "Huginn-style event log flowing between scenario steps (optional)",
      "items": {
        "type": "object",
        "required": ["name", "producedAt"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Event type e.g. inquiry.received, mail.sent"
          },
          "producedAt": {
            "type": "string",
            "minLength": 8,
            "description": "ISO-8601 or YYYY-MM-DD"
          },
          "payload": {
            "type": "object",
            "description": "Step-specific data; no invented ₪ or Insights"
          },
          "sourceAgent": {
            "type": "string",
            "description": "Pack or scenario step that emitted the event"
          }
        }
      }
    }
  }
}
