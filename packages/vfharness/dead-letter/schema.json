{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velvetos-dead-letter-item",
  "type": "object",
  "required": [
    "actionId",
    "jobOrContentId",
    "attemptedTool",
    "time",
    "failureSummary",
    "retries",
    "fallbackAttempted",
    "currentState",
    "nextSafeAction",
    "riskColor",
    "christianRequired"
  ],
  "properties": {
    "actionId": { "type": "string", "minLength": 1 },
    "jobOrContentId": { "type": "string", "minLength": 1 },
    "attemptedTool": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "minLength": 1 },
    "failureSummary": { "type": "string", "minLength": 1 },
    "retries": { "type": "integer", "minimum": 0 },
    "fallbackAttempted": { "type": "boolean" },
    "currentState": { "type": "string", "minLength": 1 },
    "nextSafeAction": { "type": "string", "minLength": 1 },
    "riskColor": {
      "type": "string",
      "enum": ["GREEN", "YELLOW", "ORANGE", "RED"]
    },
    "christianRequired": { "type": "boolean" },
    "resolved": { "type": "boolean" },
    "resolvedAt": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
