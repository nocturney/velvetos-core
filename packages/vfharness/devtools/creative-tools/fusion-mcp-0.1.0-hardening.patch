+"""Thread-safe readiness state shared by the Fusion add-in and HTTP bridge."""
+import threading
+import time
+
+_lock = threading.Lock()
+_ready = threading.Event()
+_ready_at = None
+_reason = "fusion_startup_incomplete"
+_ready_timer = None
+
+
+def _cancel_timer_locked():
+    global _ready_timer
+    if _ready_timer is not None:
+        try:
+            _ready_timer.cancel()
+        except Exception:
+            pass
+        _ready_timer = None
+
+
+def mark_ready(reason="startup_completed"):
+    global _ready_at, _reason
+    with _lock:
+        _cancel_timer_locked()
+        _reason = str(reason)
+        _ready_at = time.time()
+        _ready.set()
+
+
+def schedule_ready(delay_seconds=25, reason="ui_settle_grace_elapsed"):
+    """Become ready after a non-blocking post-startup UI settle window."""
+    global _ready_at, _reason, _ready_timer
+    delay = max(0.0, float(delay_seconds))
+
+    def complete():
+        global _ready_at, _reason, _ready_timer
+        with _lock:
+            _ready_timer = None
+            _reason = str(reason)
+            _ready_at = time.time()
+            _ready.set()
+
+    with _lock:
+        _cancel_timer_locked()
+        _ready.clear()
+        _ready_at = None
+        _reason = "fusion_ui_settling"
+        timer = threading.Timer(delay, complete)
+        timer.daemon = True
+        _ready_timer = timer
+        timer.start()
+
+
+def mark_not_ready(reason="fusion_startup_incomplete"):
+    global _ready_at, _reason
+    with _lock:
+        _cancel_timer_locked()
+        _ready_at = None
+        _reason = str(reason)
+        _ready.clear()
+
+
+def snapshot():
+    with _lock:
+        return {
+            "ready": _ready.is_set(),
+            "reason": _reason,
+            "ready_at_unix": _ready_at,
+        }
