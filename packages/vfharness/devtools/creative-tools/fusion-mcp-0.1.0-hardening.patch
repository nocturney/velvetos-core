@@ -0,0 +1,435 @@
+"""Bounded typed Fusion operations for VelvetOS production routing."""
+import json
+import os
+import re
+import time
+
+import adsk.core
+import adsk.fusion
+
+from ..mcp_primitives.item import Item
+from ..mcp_primitives.registry import register
+from ..mcp_primitives.tool import Tool
+from ..velvet_config import BRIDGE_VERSION, UPSTREAM_SHA
+
+app = adsk.core.Application.get()
+ui = app.userInterface
+_TEMP_DOCUMENTS = []
+_PENDING_TEMP_CREATE = None
+_ACCEPTANCE_GATE_PATH = r"D:\Velvet\State\CreativeTools\Fusion\acceptance.enabled"
+
+
+def _reply(payload, is_error=False):
+    return {
+        "content": [{"type": "text", "text": json.dumps(payload, sort_keys=True)}],
+        "isError": bool(is_error),
+        "data": payload,
+    }
+
+
+def _design():
+    design = adsk.fusion.Design.cast(app.activeProduct)
+    if not design:
+        raise RuntimeError("No active Fusion design")
+    return design
+
+
+def _wait_for_design_workspace(timeout_seconds=90):
+    """Pump Fusion events until the Design workspace is fully active and usable."""
+    deadline = time.time() + float(timeout_seconds)
+    last_workspace = None
+    while time.time() < deadline:
+        workspace = ui.activeWorkspace if ui else None
+        last_workspace = workspace.id if workspace else None
+        design = adsk.fusion.Design.cast(app.activeProduct)
+        if last_workspace == "FusionSolidEnvironment" and design and design.rootComponent:
+            return design
+        adsk.doEvents()
+        time.sleep(0.05)
+    raise RuntimeError(
+        f"Fusion Design workspace did not become ready within {timeout_seconds}s "
+        f"(active_workspace={last_workspace!r})"
+    )
+
+
+def _prepare_mutation():
+    """Return an open Fusion document to its idle Select command before writes."""
+    if not app.activeDocument:
+        return
+    if ui and ui.activeCommand != "SelectCommand":
+        select_command = ui.commandDefinitions.itemById("SelectCommand")
+        if select_command:
+            select_command.execute()
+
+
+def _wait_for_idle_design(timeout_seconds=10):
+    """Pump Fusion until the Design workspace is idle on its default Select command."""
+    deadline = time.time() + float(timeout_seconds)
+    last_command = None
+    last_workspace = None
+    while time.time() < deadline:
+        adsk.doEvents()
+        try:
+            last_command = ui.activeCommand if ui else None
+        except Exception:
+            last_command = None
+        try:
+            workspace = ui.activeWorkspace if ui else None
+            last_workspace = workspace.id if workspace else None
+        except Exception:
+            last_workspace = None
+        design = adsk.fusion.Design.cast(app.activeProduct)
+        if (
+            last_command == "SelectCommand"
+            and last_workspace == "FusionSolidEnvironment"
+            and design
+            and design.rootComponent
+        ):
+            return design
+        time.sleep(0.05)
+    raise RuntimeError(
+        f"Fusion did not return to an idle Design state within {timeout_seconds}s "
+        f"(active_command={last_command!r}, active_workspace={last_workspace!r})"
+    )
+
+
+def _safe_output_path(path, fmt):
+    root = os.path.normcase(os.path.abspath(r"D:\Velvet"))
+    output = os.path.normcase(os.path.abspath(path))
+    if os.path.commonpath([root, output]) != root:
+        raise ValueError("Export path must stay under D:\\Velvet")
+    expected_ext = ".step" if fmt == "step" else ".stl"
+    if not output.endswith(expected_ext):
+        raise ValueError(f"{fmt} export must end with {expected_ext}")
+    os.makedirs(os.path.dirname(output), exist_ok=True)
+    return output
+
+
+def status_handler():
+    doc = app.activeDocument
+    design = adsk.fusion.Design.cast(app.activeProduct)
+    try:
+        startup_complete = bool(app.isStartupComplete)
+    except Exception:
+        startup_complete = None
+    try:
+        workspace = ui.activeWorkspace.id if ui and ui.activeWorkspace else None
+    except Exception:
+        workspace = None
+    return _reply({
+        "bridge_version": BRIDGE_VERSION,
+        "upstream_sha": UPSTREAM_SHA,
+        "fusion_version": str(app.version),
+        "startup_complete": startup_complete,
+        "active_workspace": workspace,
+        "active_document": doc.name if doc else None,
+        "design_active": bool(design),
+        "temporary_document_tracked": bool(doc and any(d == doc for d in _TEMP_DOCUMENTS)),
+    })
+
+
+def native_mcp_probe_handler():
+    results = {}
+    for command in ("MCP.Server", "MCP.Port", "MCP.ServerURL"):
+        try:
+            results[command] = app.executeTextCommand(command)
+        except Exception as exc:
+            results[command] = {"error": type(exc).__name__, "message": str(exc)}
+    return _reply({"commands": results})
+
+
+def native_mcp_enable_handler():
+    before = {
+        "server": app.executeTextCommand("MCP.Server"),
+        "port": app.executeTextCommand("MCP.Port"),
+        "url": app.executeTextCommand("MCP.ServerURL"),
+    }
+    if "27182" not in str(before["port"]):
+        app.executeTextCommand("MCP.Port 27182")
+    app.executeTextCommand("MCP.Server /on")
+    after = {
+        "server": app.executeTextCommand("MCP.Server"),
+        "port": app.executeTextCommand("MCP.Port"),
+        "url": app.executeTextCommand("MCP.ServerURL"),
+    }
+    if "running at" not in str(after["server"]).lower():
+        raise RuntimeError(f"Native Fusion MCP did not start: {after['server']}")
+    return _reply({
+        "changed": str(before["server"]) != str(after["server"]),
+        "before": before,
+        "after": after,
+    })
+
+
+def new_design_command_probe_handler():
+    rows = []
+    definitions = ui.commandDefinitions
+    needles = ("new design", "new document", "newdesign", "newdocument", "create design")
+    for i in range(definitions.count):
+        definition = definitions.item(i)
+        text = " ".join([
+            str(getattr(definition, "id", "")),
+            str(getattr(definition, "name", "")),
+            str(getattr(definition, "description", "")),
+        ]).lower()
+        if any(needle in text for needle in needles) or ("new" in text and ("document" in text or "design" in text)):
+            rows.append({
+                "id": getattr(definition, "id", ""),
+                "name": getattr(definition, "name", ""),
+                "description": getattr(definition, "description", ""),
+            })
+    return _reply({"commands": rows})
+
+
+def start_temp_design_handler(label="VelvetOS Acceptance"):
+    global _PENDING_TEMP_CREATE
+    if not isinstance(label, str) or not label.strip() or len(label) > 80:
+        raise ValueError("label must be 1-80 characters")
+    if app.activeDocument:
+        raise RuntimeError("Refusing to create a temporary design while another document is open")
+    if _PENDING_TEMP_CREATE is not None:
+        raise RuntimeError("A temporary design creation is already pending")
+
+    pending = {
+        "before_count": app.documents.count,
+        "started_at": time.time(),
+        "label": label.strip(),
+    }
+    result = app.executeTextCommand("Commands.Start NewSingleDocumentCommand")
+    _PENDING_TEMP_CREATE = pending
+    return _reply({
+        "started": True,
+        "pending": True,
+        "command": "NewSingleDocumentCommand",
+        "requested_label": label.strip(),
+        "text_command_result": result,
+    })
+
+
+def adopt_temp_design_handler():
+    global _PENDING_TEMP_CREATE
+    pending = _PENDING_TEMP_CREATE
+    if pending is None:
+        raise RuntimeError("No temporary design creation is pending")
+
+    doc = app.activeDocument
+    design = adsk.fusion.Design.cast(app.activeProduct)
+    if not doc or not design or not design.rootComponent or app.documents.count <= pending["before_count"]:
+        return _reply({
+            "ready": False,
+            "pending": True,
+            "elapsed_seconds": round(time.time() - pending["started_at"], 3),
+        })
+
+    if not any(existing == doc for existing in _TEMP_DOCUMENTS):
+        _TEMP_DOCUMENTS.append(doc)
+    _PENDING_TEMP_CREATE = None
+    return _reply({
+        "ready": True,
+        "created": True,
+        "document": doc.name,
+        "root_component": design.rootComponent.name,
+        "tracked_temporary": True,
+        "creation_command": "NewPartDocumentCommand",
+        "requested_label": pending["label"],
+    })
+
+
+def design_summary_handler():
+    design = _wait_for_design_workspace(timeout_seconds=20)
+    root = design.rootComponent
+    params = design.userParameters
+    return _reply({
+        "document": app.activeDocument.name if app.activeDocument else None,
+        "root_component": root.name,
+        "bodies": root.bRepBodies.count,
+        "occurrences": root.occurrences.count,
+        "sketches": root.sketches.count,
+        "user_parameters": params.count,
+        "parameter_names": [params.item(i).name for i in range(params.count)],
+    })
+
+
+def create_temp_design_handler(label="VelvetOS Acceptance"):
+    if not isinstance(label, str) or not label.strip() or len(label) > 80:
+        raise ValueError("label must be 1-80 characters")
+    if app.activeDocument:
+        raise RuntimeError("Refusing to create a temporary design while another document is open")
+
+    before_count = app.documents.count
+    doc = app.documents.add(adsk.core.DocumentTypes.FusionDesignDocumentType)
+    if not doc:
+        raise RuntimeError("Fusion documents.add did not return a document")
+    _TEMP_DOCUMENTS.append(doc)
+
+    try:
+        design = _wait_for_design_workspace(timeout_seconds=20)
+        _prepare_mutation()
+        try:
+            design = _wait_for_idle_design(timeout_seconds=10)
+        except Exception:
+            design = _wait_for_design_workspace(timeout_seconds=5)
+        if app.activeDocument != doc:
+            raise RuntimeError("Fusion changed the active document during temporary design creation")
+        if app.documents.count <= before_count:
+            raise RuntimeError("Fusion document count did not increase after documents.add")
+        return _reply({
+            "created": True,
+            "document": doc.name,
+            "root_component": design.rootComponent.name,
+            "tracked_temporary": True,
+            "creation_api": "Documents.add(FusionDesignDocumentType)",
+            "requested_label": label.strip(),
+        })
+    except Exception:
+        if doc in _TEMP_DOCUMENTS:
+            _TEMP_DOCUMENTS.remove(doc)
+        try:
+            doc.close(False)
+        except Exception:
+            pass
+        raise
+
+
+def set_user_parameter_handler(name, expression, units="mm", comment="VelvetOS"):
+    _prepare_mutation()
+    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,63}", str(name)):
+        raise ValueError("parameter name must be a simple identifier")
+    if units not in {"mm", "cm", "m", "in", "deg", "rad"}:
+        raise ValueError("unsupported units")
+    if not isinstance(expression, str) or not expression.strip() or len(expression) > 128:
+        raise ValueError("expression must be 1-128 characters")
+    design = _wait_for_design_workspace(timeout_seconds=20)
+    params = design.userParameters
+    existing = params.itemByName(name)
+    created = existing is None
+    if existing:
+        existing.expression = expression.strip()
+        param = existing
+    else:
+        value = adsk.core.ValueInput.createByString(expression.strip())
+        param = params.add(name, value, units, str(comment)[:128])
+    return _reply({
+        "name": param.name,
+        "expression": param.expression,
+        "unit": param.unit,
+        "created": created,
+    })
+
+
+def create_box_handler(width_mm=20.0, height_mm=20.0, depth_mm=10.0):
+    _prepare_mutation()
+    dims = [float(width_mm), float(height_mm), float(depth_mm)]
+    if any(v <= 0 or v > 100000 for v in dims):
+        raise ValueError("box dimensions must be >0 and <=100000 mm")
+    design = _wait_for_design_workspace(timeout_seconds=20)
+    root = design.rootComponent
+    sketch = root.sketches.add(root.xYConstructionPlane)
+    lines = sketch.sketchCurves.sketchLines
+    lines.addTwoPointRectangle(
+        adsk.core.Point3D.create(0, 0, 0),
+        adsk.core.Point3D.create(dims[0] / 10.0, dims[1] / 10.0, 0),
+    )
+    if sketch.profiles.count < 1:
+        raise RuntimeError("box sketch did not produce a profile")
+    extrudes = root.features.extrudeFeatures
+    feature = extrudes.addSimple(
+        sketch.profiles.item(0),
+        adsk.core.ValueInput.createByString(f"{dims[2]} mm"),
+        adsk.fusion.FeatureOperations.NewBodyFeatureOperation,
+    )
+    return _reply({
+        "created": True,
+        "feature": feature.name,
+        "body_count": feature.bodies.count,
+        "width_mm": dims[0],
+        "height_mm": dims[1],
+        "depth_mm": dims[2],
+    })
+
+
+def export_design_handler(format, output_path):
+    fmt = str(format).lower()
+    if fmt not in {"step", "stl"}:
+        raise ValueError("format must be step or stl")
+    design = _wait_for_design_workspace(timeout_seconds=20)
+    output = _safe_output_path(str(output_path), fmt)
+    manager = design.exportManager
+    if fmt == "step":
+        options = manager.createSTEPExportOptions(output, design.rootComponent)
+    else:
+        options = manager.createSTLExportOptions(design.rootComponent, output)
+    if not options:
+        raise RuntimeError(f"Fusion could not create {fmt} export options")
+    ok = bool(manager.execute(options))
+    exists = os.path.isfile(output)
+    size = os.path.getsize(output) if exists else 0
+    if not ok or not exists or size <= 0:
+        raise RuntimeError(f"{fmt} export failed verification")
+    return _reply({"format": fmt, "path": output, "bytes": size, "verified": True})
+
+
+def close_temp_design_handler():
+    _prepare_mutation()
+    doc = app.activeDocument
+    if not doc:
+        raise RuntimeError("No active document")
+    match = next((d for d in _TEMP_DOCUMENTS if d == doc), None)
+    if not match:
+        raise RuntimeError("Active document was not created by VelvetOS temp-design tool")
+    name = doc.name
+    _TEMP_DOCUMENTS.remove(match)
+    doc.close(False)
+    return _reply({"closed": True, "document": name, "saved": False})
+
+
+def _register(tool, handler):
+    register(Item.create_tool_item(tool=tool.strict_schema(), handler=handler))
+
+
+_register(Tool.create_simple("velvet_fusion_status", "Read Fusion and bridge status."), status_handler)
+_register(Tool.create_simple("velvet_probe_native_mcp", "Read built-in Autodesk Fusion MCP server state without changing it."), native_mcp_probe_handler)
+_register(Tool.create_simple("velvet_enable_native_mcp", "Enable Autodesk Fusion's built-in local MCP server on port 27182 with readback."), native_mcp_enable_handler)
+_register(Tool.create_simple("velvet_design_summary", "Read active design structure and user parameters."), design_summary_handler)
+
+if os.path.isfile(_ACCEPTANCE_GATE_PATH):
+    start_temp = Tool.create_simple(
+        "velvet_acceptance_start_temp_design",
+        "Acceptance-only: start asynchronous creation of one temporary Fusion design while the local acceptance gate exists.",
+    )
+    start_temp.add_input_property("label", {"type": "string", "minLength": 1, "maxLength": 80})
+    _register(start_temp, start_temp_design_handler)
+    _register(
+        Tool.create_simple(
+            "velvet_acceptance_adopt_temp_design",
+            "Acceptance-only: adopt the asynchronously created temporary Fusion design after it becomes active.",
+        ),
+        adopt_temp_design_handler,
+    )
+    _register(
+        Tool.create_simple(
+            "velvet_acceptance_close_temp_design",
+            "Acceptance-only: close the active tracked temporary Fusion design without saving.",
+        ),
+        close_temp_design_handler,
+    )
+
+set_param = Tool.create_simple("velvet_set_user_parameter", "Create or update one user parameter in the active design.")
+set_param.add_input_property("name", {"type": "string"})
+set_param.add_input_property("expression", {"type": "string"})
+set_param.add_input_property("units", {"type": "string", "enum": ["mm", "cm", "m", "in", "deg", "rad"]})
+set_param.add_input_property("comment", {"type": "string", "maxLength": 128})
+set_param.add_required_input("name").add_required_input("expression")
+_register(set_param, set_user_parameter_handler)
+
+box = Tool.create_simple("velvet_create_box", "Create one rectangular box body in the active design.")
+for key in ("width_mm", "height_mm", "depth_mm"):
+    box.add_input_property(key, {"type": "number", "exclusiveMinimum": 0, "maximum": 100000})
+_register(box, create_box_handler)
+
+export = Tool.create_simple("velvet_export_design", "Export the active design to a verified STEP or STL file under D:\\Velvet.")
+export.add_input_property("format", {"type": "string", "enum": ["step", "stl"]})
+export.add_input_property("output_path", {"type": "string"})
+export.add_required_input("format").add_required_input("output_path")
+_register(export, export_design_handler)
+
