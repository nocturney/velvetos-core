+def _loopback_listener_pid(broker_url: str) -> int | None:
+    """Resolve the PID bound to an exact loopback broker endpoint on Windows."""
+    from urllib.parse import urlparse  # noqa: PLC0415
+
+    try:
+        parsed = urlparse(broker_url)
+        port = parsed.port
+    except (TypeError, ValueError):
+        return None
+    hostname = (parsed.hostname or "").lower()
+    if parsed.scheme != "http" or hostname not in {"127.0.0.1", "localhost", "::1"} or port not in range(1, 65_536):
+        return None
+    if sys.platform != "win32":
+        return None
+    try:
+        result = subprocess.run(
+            ["netstat", "-ano", "-p", "tcp"],
+            capture_output=True,
+            text=True,
+            timeout=3,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    if result.returncode != 0:
+        return None
+    allowed_hosts = {"127.0.0.1", "::1"} if hostname == "localhost" else {hostname}
+    for line in result.stdout.splitlines():
+        fields = line.split()
+        if len(fields) < 5 or fields[0].upper() != "TCP" or fields[3].upper() != "LISTENING":
+            continue
+        try:
+            local_host, local_port_text = fields[1].rsplit(":", 1)
+            local_port = int(local_port_text)
+            pid = int(fields[4])
+        except (ValueError, IndexError):
+            continue
+        local_host = local_host.strip("[]").lower()
+        if local_port == port and local_host in allowed_hosts and 0 < pid <= 2_147_483_647:
+            return pid
+    return None
+
