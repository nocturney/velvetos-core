+    boolean_ops = list(project.get("boolean_ops", [])) + _derived_boolean_ops(project)
@@ -540,2 +574,20 @@ def _gen_export(
-    # Collect all visible shape objects for export
-    lines.append("# Collect all shape objects for export")
+    # Export only the project-state objects that are currently visible.
+    visible_names = [
+        _safe_name(part.get("name", ""))
+        for part in project.get("parts", [])
+        if part.get("visible", True)
+    ]
+    visible_names.extend(
+        _safe_name(body.get("name", "Body"))
+        for body in project.get("bodies", [])
+        if body.get("visible", True)
+    )
+    visible_names.extend(
+        _safe_name(op.get("name", ""))
+        for op in project.get("boolean_ops", [])
+        if op.get("name")
+    )
+    # Preserve order while removing duplicates/empty names.
+    visible_names = list(dict.fromkeys(name for name in visible_names if name))
+    lines.append("# Collect visible project-state shape objects for export")
+    lines.append(f"export_names = {visible_names!r}")
