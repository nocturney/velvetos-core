@@ -160,0 +161,30 @@ def _render_spec_for_part(project: dict, part: Dict[str, Any]) -> Optional[Dict[
+_BOOLEAN_PART_TYPES = {"cut", "fuse", "common"}
+
+
+def _derived_boolean_ops(project: dict) -> List[Dict[str, Any]]:
+    """Translate current parts-state boolean results into macro boolean specs."""
+    parts = project.get("parts", [])
+    names_by_id = {
+        part.get("id"): _safe_name(part.get("name", ""))
+        for part in parts
+        if part.get("id") is not None
+    }
+    derived: List[Dict[str, Any]] = []
+    for part in parts:
+        part_type = str(part.get("type", "")).lower()
+        if part_type not in _BOOLEAN_PART_TYPES:
+            continue
+        params = part.get("params") or {}
+        base_name = names_by_id.get(params.get("base_id"))
+        tool_name = names_by_id.get(params.get("tool_id"))
+        if not base_name or not tool_name:
+            continue
+        derived.append({
+            "type": part_type,
+            "name": _safe_name(part.get("name", part_type.capitalize())),
+            "base": base_name,
+            "tool": tool_name,
+        })
+    return derived
+
+
