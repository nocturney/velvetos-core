-    """Generate Part primitives (Box, Cylinder, Sphere, Cone, Torus)."""
+    """Generate Part primitives; defer boolean result parts to _gen_boolean_ops."""
@@ -168,0 +199,4 @@ def _gen_parts(project: dict) -> List[str]:
