{
  "manifestVersion": 5,
  "id": "com.velvetos.premiere.bridge",
  "name": "VelvetOS Premiere Bridge",
  "version": "0.1.3",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "velvetPremiereBridge",
      "label": {
        "default": "VelvetOS Bridge"
      },
      "minimumSize": {
        "width": 180,
        "height": 90
      },
      "maximumSize": {
        "width": 500,
        "height": 360
      },
      "preferredDockedSize": {
        "width": 240,
        "height": 120
      },
      "preferredFloatingSize": {
        "width": 280,
        "height": 140
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    }
  },
  "main": "index.html"
}