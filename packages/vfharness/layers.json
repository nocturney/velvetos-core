        "constitution/CONSTITUTION.md",
        ".cursor/rules/velvet-factory-desk.mdc",
        "packages/vfharness/SKILL.md"
      ]
    },
    {
      "id": 2,
      "name": "sensors",
      "role": "feedback",
      "files": [
        "scripts/check-all.py",
        "scripts/check-hq-overlay.py",
        "scripts/check-vf-desk.py",
        "scripts/check-vfharness.py"
      ]
    },
    {
      "id": 3,
      "name": "loop",
      "role": "bounded-execution",
      "files": [
        "packages/vfharness/LOOP.md",
        "packages/vfharness/templates/escalation.md",
        ".cursor/skills/vf-harness/SKILL.md"
      ]
    },
    {
      "id": 4,
      "name": "memory",
      "role": "durable-state",
