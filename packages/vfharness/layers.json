{
  "name": "vfharness",
  "formula": "Agent = Model + Harness",
  "embeddedAt": "2026-08-30",
  "rule": "Embed the six layers onto existing packs. Do not add a second agent runtime.",
  "source": {
    "title": "Production Agent Engineering Practice 2026 — Harness Engineering",
    "uploadedAs": "harness_final_ea2c.pdf",
    "readAt": "2026-08-30",
    "note": "Independent compilation uploaded by the owner. Not affiliated with Google, OpenAI, Anthropic, or HashiCorp. Adapted for Velvet Factory HQ; not an official spec."
  },
  "locks": [
    "hq-send-via-tools",
    "no-auto-dm",
    "no-boost",
    "no-invented-prices",
    "no-invented-insights",
    "no-second-runtime",
    "no-llm-judge-as-gate"
  ],
  "loop": {
    "maxRetries": 2,
    "escalateAfter": 2,
    "sameSensorFailTrip": 3,
    "stoppingCondition": "best-artifact-plus-unresolved"
  },
  "layers": [
    {
      "id": 1,
      "name": "guides",
      "role": "feedforward",
      "files": [
