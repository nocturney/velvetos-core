{
  "steps": [
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "-t",
        "$_IMAGE",
        "-f",
        "packages/vfigos/approval/issuer/Dockerfile",
        "."
      ]
    }
  ],
  "images": [
    "$_IMAGE"
  ],
  "substitutions": {
    "_IMAGE": "gcr.io/instamcp/velvet-delivery-approval-issuer:v1"
  },
  "serviceAccount": "projects/instamcp/serviceAccounts/velvet-vfigos-builder@instamcp.iam.gserviceaccount.com",
  "options": {
    "logging": "CLOUD_LOGGING_ONLY"
  }
}
