+func TestAmbiguousVelvetTimeoutPreservesKindWithoutAutoRetry(t *testing.T) {
+	err := &providerwrite.OutcomeError{
+		Kind: providerwrite.StatusAmbiguous,
+		Err: &platform.HTTPError{StatusCode: http.StatusRequestTimeout, Code: "velvet:timeout"},
+	}
+	failure := ClassifyFailure(err)
+	require.Equal(t, FailureNetwork, failure.Kind)
+	require.Equal(t, "velvet:timeout", failure.Code)
+	require.False(t, failure.Retryable)
+	require.Equal(t, FailureActionProvider, failure.Action)
+}
+
+func TestVelvetRateLimitRemainsRetryable(t *testing.T) {
+	failure := ClassifyFailure(&platform.HTTPError{StatusCode: http.StatusTooManyRequests, Code: "velvet:rate_limited"})
+	require.Equal(t, FailureRateLimited, failure.Kind)
+	require.True(t, failure.Retryable)
+	require.Equal(t, FailureActionRetry, failure.Action)
+}
